    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.7"
