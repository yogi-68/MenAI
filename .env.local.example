# === MenAI Environment Variables ===

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI
OPENAI_API_KEY=your_openai_api_key
# Fast model (~90–95% of traffic): chat, extraction, plans, reflections
OPENAI_FAST_MODEL=gpt-4o-mini
# Deep model (rare): weekly reviews, milestones, completion reviews, crisis chat
OPENAI_DEEP_MODEL=gpt-4o

# Upstash Redis (REQUIRED for production caching)
# Sign up at: https://upstash.com/
# Create a Redis database and copy these values:
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Resend (auth emails)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=MenAI <onboarding@resend.dev>
NEXT_PUBLIC_APP_URL=https://men-ai.vercel.app

# Stripe (optional, for payments)
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
